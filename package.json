{
  "name": "marbleland",
  "version": "1.0.0",
  "description": "Custom level sharing platform for Marble Blast",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=server/ts --watch-path=server/lib --watch-path=shared dev.ts",
    "check": "vue-tsc --noEmit",
    "build": "npm run check && vite build && vite build --ssr",
    "start": "node server/server_bundle.js",
    "add-directory": "node server/server_bundle.js add-directory",
    "reimport": "node server/server_bundle.js reimport"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@imagemagick/magick-wasm": "^0.0.45",
    "@seald-io/nedb": "^4.1.2",
    "@unhead/vue": "^3.4.3",
    "bcryptjs": "^3.0.3",
    "codejar": "^4.3.0",
    "custom-protocol-check": "^1.4.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "mitt": "^3.0.1",
    "multer": "^2.5.0",
    "serialize-javascript": "^7.1.3",
    "sharp": "^0.35.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuex": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/serialize-javascript": "^5.0.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  },
  "allowScripts": {
    "fsevents": false
  }
}
