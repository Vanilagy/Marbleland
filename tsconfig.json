{
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "isolatedModules": true,
    "strict": true,
    "strictNullChecks": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "paths": {
      // Vuex's package.json "exports" don't point at its types
      "vuex": ["./node_modules/vuex/types/index.d.ts"]
    }
  },
  "include": [
    "client/ts/**/*",
    "client/vue/**/*",
    "server/**/*",
    "shared/**/*",
    "dev.ts",
    "vite.config.ts"
  ]
}
